<Window x:Class="ClientManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClientManager - Gestão de Clientes Offline" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9" Loaded="Window_Loaded"
        Icon="../app_icon.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & App Title -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ClientManager" FontSize="24" FontWeight="Bold" Foreground="#0D6EFD"/>
                <TextBlock Text=" | Sistema de Cadastro e Migração Offline" FontSize="14" Foreground="#6C757D" VerticalAlignment="Bottom" Margin="8,0,0,2"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Modo Banco:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CboModoBanco" Width="150" Height="28" SelectionChanged="CboModoBanco_SelectionChanged">
                    <ComboBoxItem Content="SQLite (Local)" Tag="SqliteLocal" IsSelected="True"/>
                    <ComboBoxItem Content="SQL Server (Rede)" Tag="SqlServerRede"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Search Bar & Action Buttons -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtBusca" Width="300" Height="32" VerticalContentAlignment="Center" Padding="6,0" TextChanged="TxtBusca_TextChanged" ToolTip="Digite Nome ou CPF para filtrar em tempo real"/>
                <Button x:Name="BtnLimparBusca" Content="Limpar" Height="32" Padding="12,0" Margin="6,0,0,0" Click="BtnLimparBusca_Click" Background="#E9ECEF" BorderThickness="1" BorderBrush="#CED4DA"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="BtnNovo" Content="+ Novo Cliente" Height="34" Padding="16,0" Margin="0,0,6,0" Click="BtnNovo_Click" Background="#198754" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                <Button x:Name="BtnEditar" Content="Editar" Height="34" Padding="14,0" Margin="0,0,6,0" Click="BtnEditar_Click" Background="#0D6EFD" Foreground="White" BorderThickness="0"/>
                <Button x:Name="BtnExcluir" Content="Excluir" Height="34" Padding="14,0" Margin="0,0,12,0" Click="BtnExcluir_Click" Background="#DC3545" Foreground="White" BorderThickness="0"/>
                <Button x:Name="BtnImportar" Content="📥 Importar Base Antiga" Height="34" Padding="14,0" Click="BtnImportar_Click" Background="#6F42C1" Foreground="White" FontWeight="Bold" BorderThickness="0" ToolTip="Importar ~9.000 clientes do sistema antigo (CSV/Texto)"/>
            </StackPanel>
        </Grid>

        <!-- DataGrid Listing Clientes -->
        <DataGrid x:Name="GridClientes" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  Background="White" RowHeaderWidth="0" MouseDoubleClick="GridClientes_MouseDoubleClick" AlternatingRowBackground="#F8F9FA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome Completo" Binding="{Binding NomeCompleto}" Width="2*"/>
                <DataGridTextColumn Header="CPF" Binding="{Binding Cpf}" Width="1.2*"/>
                <DataGridTextColumn Header="RG" Binding="{Binding Rg}" Width="1*"/>
                <DataGridTextColumn Header="CNH" Binding="{Binding Cnh}" Width="1*"/>
                <DataGridTextColumn Header="Cidade" Binding="{Binding Cidade}" Width="1.2*"/>
                <DataGridTextColumn Header="UF" Binding="{Binding Estado}" Width="0.5*"/>
                <DataGridTextColumn Header="Telefone / Celular" Binding="{Binding Celular}" Width="1.2*"/>
                <DataGridTextColumn Header="Data Cadastro" Binding="{Binding DataCadastro, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="1.3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Progress Bar for Migration -->
        <ProgressBar x:Name="ProgressoImportacao" Grid.Row="3" Height="6" Margin="0,8,0,0" Visibility="Collapsed" Foreground="#6F42C1"/>

        <!-- Status Bar Footer -->
        <Border Grid.Row="4" Background="#E9ECEF" CornerRadius="4" Margin="0,8,0,0" Padding="8,6">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="Pronto" VerticalAlignment="Center" Foreground="#495057"/>
                <TextBlock x:Name="TxtTotal" Text="Total de clientes: 0 | Conectado em: SQLite Local" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="#212529"/>
            </Grid>
        </Border>
    </Grid>
</Window>
