<Window x:Class="ClientManager.Views.ClienteFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro / Edição de Cliente" Height="580" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8F9FA"
        Icon="../app_icon.ico">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtTitulo" Text="Cadastro de Cliente" FontSize="20" FontWeight="Bold" Foreground="#0D6EFD" Margin="0,0,0,12"/>

        <!-- Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <!-- GroupBox Dados Pessoais -->
                <GroupBox Header="Dados Pessoais" Margin="0,0,0,12" Padding="10" FontWeight="SemiBold">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="4">
                            <TextBlock Text="Nome Completo *" FontWeight="Normal"/>
                            <TextBox x:Name="TxtNomeCompleto" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="CPF *" FontWeight="Normal"/>
                            <TextBox x:Name="TxtCpf" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="RG" FontWeight="Normal"/>
                            <TextBox x:Name="TxtRg" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="4">
                            <TextBlock Text="CNH" FontWeight="Normal"/>
                            <TextBox x:Name="TxtCnh" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4">
                            <TextBlock Text="Categoria CNH" FontWeight="Normal"/>
                            <TextBox x:Name="TxtCnhCategoria" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- GroupBox Endereço -->
                <GroupBox Header="Endereço" Margin="0,0,0,12" Padding="10" FontWeight="SemiBold">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                            <TextBlock Text="Logradouro / Endereço" FontWeight="Normal"/>
                            <TextBox x:Name="TxtLogradouro" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                            <TextBlock Text="Número" FontWeight="Normal"/>
                            <TextBox x:Name="TxtNumero" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                            <TextBlock Text="Bairro" FontWeight="Normal"/>
                            <TextBox x:Name="TxtBairro" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                            <TextBlock Text="CEP" FontWeight="Normal"/>
                            <TextBox x:Name="TxtCep" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="4">
                            <TextBlock Text="Cidade" FontWeight="Normal"/>
                            <TextBox x:Name="TxtCidade" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="4">
                            <TextBlock Text="Estado (UF)" FontWeight="Normal"/>
                            <TextBox x:Name="TxtEstado" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- GroupBox Contato -->
                <GroupBox Header="Contato" Margin="0,0,0,12" Padding="10" FontWeight="SemiBold">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="4">
                            <TextBlock Text="Telefone Fixo" FontWeight="Normal"/>
                            <TextBox x:Name="TxtTelefone" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4">
                            <TextBlock Text="Celular / WhatsApp" FontWeight="Normal"/>
                            <TextBox x:Name="TxtCelular" Height="28" VerticalContentAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancelar" Content="Cancelar" Width="100" Height="32" Margin="0,0,8,0" Click="BtnCancelar_Click" Background="#6C757D" Foreground="White" BorderThickness="0"/>
            <Button x:Name="BtnSalvar" Content="Salvar" Width="110" Height="32" Click="BtnSalvar_Click" Background="#0D6EFD" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
