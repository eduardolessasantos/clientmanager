<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<connectionStrings>
		<!-- Modo DEMO: SQLite Local (Arquivo clientes.db) -->
		<add name="SqliteLocal" connectionString="Data Source=clientes.db" providerName="Microsoft.Data.Sqlite" />
		
		<!-- Modo PRODUÇÃO: SQL Server Express em Rede Local -->
		<add name="SqlServerRede" connectionString="Server=192.168.0.100\SQLEXPRESS;Database=ClientManager;Trusted_Connection=True;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
	</connectionStrings>
	<appSettings>
		<!-- Modo de operação padrão: "SqliteLocal" ou "SqlServerRede" -->
		<add key="ModoBancoPadrao" value="SqliteLocal" />
	</appSettings>
</configuration>
