@page "{id:guid}"
@model ClientManager.Web.Pages.Projects.DetailsModel
@{
    ViewData["Title"] = "Detalhes do Projeto";
    var statusBadgeClass = Model.Project.Status switch
    {
        "Concluído" => "bg-success text-white",
        "Em Andamento" => "bg-primary text-white",
        "Planejamento" => "bg-warning text-dark",
        "Pausado" => "bg-secondary text-white",
        _ => "bg-info text-dark"
    };
}

<div class="container mt-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-page="/Projects/Index">Projetos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Project.Title</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start mb-4 gap-3">
                <div>
                    <span class="badge @statusBadgeClass px-3 py-2 rounded-pill fw-medium mb-3">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> @Model.Project.Status
                    </span>
                    <h1 class="display-6 fw-bold text-dark mb-2">@Model.Project.Title</h1>
                    <p class="text-muted fs-5 mb-0">
                        <i class="bi bi-building me-2"></i>Cliente: <strong class="text-dark">@Model.Project.ClientName</strong>
                    </p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-page="/Projects/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Voltar para Projetos
                    </a>
                </div>
            </div>

            <hr class="my-4" />

            <div class="row g-4 mb-4">
                <div class="col-md-8">
                    <h5 class="fw-bold mb-3"><i class="bi bi-file-text text-primary me-2"></i>Descrição do Projeto</h5>
                    <p class="text-secondary leading-relaxed fs-6">
                        @Model.Project.Description
                    </p>
                </div>

                <div class="col-md-4">
                    <div class="p-4 bg-light rounded-3 border">
                        <h6 class="fw-bold mb-3 text-uppercase fs-7 text-muted">Informações Financeiras e Prazos</h6>

                        <div class="mb-3">
                            <small class="text-muted d-block">Orçamento Aprovado</small>
                            <span class="fs-4 fw-bold text-success">
                                @Model.Project.Budget.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                            </span>
                        </div>

                        <div class="mb-3">
                            <small class="text-muted d-block">Data de Início</small>
                            <span class="fw-semibold text-dark">
                                <i class="bi bi-calendar-event me-1 text-primary"></i>
                                @Model.Project.StartDate.ToString("dd/MM/yyyy")
                            </span>
                        </div>

                        <div>
                            <small class="text-muted d-block">Previsão de Término</small>
                            <span class="fw-semibold text-dark">
                                <i class="bi bi-calendar-check me-1 text-primary"></i>
                                @(Model.Project.EndDate.HasValue ? Model.Project.EndDate.Value.ToString("dd/MM/yyyy") : "Não definida")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
