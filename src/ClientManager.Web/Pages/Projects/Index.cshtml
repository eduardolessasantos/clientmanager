@page
@model ClientManager.Web.Pages.Projects.IndexModel
@{
    ViewData["Title"] = "Lista de Projetos";
}

<div class="container mt-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-kanban-fill text-primary me-2"></i>Lista de Projetos</h2>
            <p class="text-muted mb-0">Acompanhe e gerencie todos os projetos ativos e finalizados.</p>
        </div>

        <!-- Status Filter Buttons -->
        <div class="btn-group shadow-sm" role="group" aria-label="Filtro de Status">
            <a asp-page="/Projects/Index" class="btn btn-outline-secondary btn-sm @(string.IsNullOrEmpty(Model.SelectedStatus) ? "active" : "")">
                Todos
            </a>
            <a asp-page="/Projects/Index" asp-route-status="Em Andamento" class="btn btn-outline-primary btn-sm @(Model.SelectedStatus == "Em Andamento" ? "active" : "")">
                Em Andamento
            </a>
            <a asp-page="/Projects/Index" asp-route-status="Planejamento" class="btn btn-outline-warning btn-sm @(Model.SelectedStatus == "Planejamento" ? "active" : "")">
                Planejamento
            </a>
            <a asp-page="/Projects/Index" asp-route-status="Concluído" class="btn btn-outline-success btn-sm @(Model.SelectedStatus == "Concluído" ? "active" : "")">
                Concluídos
            </a>
        </div>
    </div>

    @if (Model.Projects.Any())
    {
        <div class="row g-4">
            @foreach (var project in Model.Projects)
            {
                <div class="col-md-6 col-lg-4">
                    <partial name="_ProjectCard" model="project" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 p-5 text-center bg-white mt-4">
            <div class="py-4">
                <i class="bi bi-folder-x text-muted" style="font-size: 4rem;"></i>
                <h4 class="fw-bold text-dark mt-3 mb-2">Nenhum projeto encontrado</h4>
                <p class="text-muted max-w-md mx-auto mb-4">
                    Não há projetos para o filtro selecionado no momento.
                </p>
                <a asp-page="/Projects/Index" class="btn btn-primary">
                    Limpar Filtros
                </a>
            </div>
        </div>
    }
</div>
