@page
@model IndexModel
@{
    ViewData["Title"] = "Página Inicial";
}

<!-- Hero Section -->
<div class="hero-section py-5 mb-5 shadow">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-primary text-white px-3 py-2 rounded-pill mb-3 fw-semibold">
                    <i class="bi bi-rocket-takeoff me-1"></i> Plataforma de Gestão 2026
                </span>
                <h1 class="display-4 fw-bold text-white mb-3">Gerencie Clientes e Projetos com Eficiência</h1>
                <p class="lead text-light mb-4 opacity-90">
                    Sistema centralizado para cadastro de novos clientes, acompanhamento de projetos em andamento, monitoramento de orçamentos e prazos.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-page="/Clients/Create" class="btn btn-primary btn-lg shadow-sm">
                        <i class="bi bi-person-plus-fill me-2"></i> Cadastrar Novo Cliente
                    </a>
                    <a asp-page="/Projects/Index" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-kanban me-2"></i> Ver Todos os Projetos
                    </a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-center">
                <div class="p-4 bg-white bg-opacity-10 rounded-4 border border-light border-opacity-20 shadow">
                    <i class="bi bi-pie-chart-fill text-primary" style="font-size: 5rem;"></i>
                    <h5 class="text-white mt-3 fw-semibold">Painel Integrado</h5>
                    <p class="text-light small opacity-75 mb-0">Consumo em tempo real via Web API RESTful</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <!-- Stat Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white hover-shadow">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="bi bi-people-fill fs-2"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 text-uppercase fw-semibold fs-7">Clientes Cadastrados</h6>
                        <h2 class="fw-bold mb-0 text-dark">@Model.TotalClientsCount</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white hover-shadow">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                        <i class="bi bi-diagram-3-fill fs-2"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 text-uppercase fw-semibold fs-7">Projetos Ativos</h6>
                        <h2 class="fw-bold mb-0 text-dark">@Model.TotalProjectsCount</h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white hover-shadow">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3">
                        <i class="bi bi-lightning-charge-fill fs-2"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 text-uppercase fw-semibold fs-7">Acesso Rápido</h6>
                        <div class="d-flex gap-2 mt-1">
                            <a asp-page="/Clients/Create" class="btn btn-sm btn-outline-primary">Novo Cliente</a>
                            <a asp-page="/Projects/Index" class="btn btn-sm btn-outline-secondary">Projetos</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Projects Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Projetos Recentes</h3>
            <p class="text-muted mb-0">Confira os últimos projetos cadastrados na plataforma</p>
        </div>
        <a asp-page="/Projects/Index" class="btn btn-outline-primary">
            Ver Todos <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    @if (Model.RecentProjects.Any())
    {
        <div class="row g-4">
            @foreach (var project in Model.RecentProjects)
            {
                <div class="col-md-6 col-lg-4">
                    <partial name="_ProjectCard" model="project" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info rounded-3 p-4 text-center">
            <i class="bi bi-info-circle fs-3 d-block mb-2"></i>
            Nenhum projeto encontrado no momento.
        </div>
    }
</div>
