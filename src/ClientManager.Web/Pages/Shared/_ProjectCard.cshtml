@model ClientManager.Web.Models.ProjectViewModel

@{
    var statusBadgeClass = Model.Status switch
    {
        "Concluído" => "bg-success text-white",
        "Em Andamento" => "bg-primary text-white",
        "Planejamento" => "bg-warning text-dark",
        "Pausado" => "bg-secondary text-white",
        _ => "bg-info text-dark"
    };
}

<div class="card h-100 shadow-sm border-0 rounded-3">
    <div class="card-body d-flex flex-column p-4">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <span class="badge @statusBadgeClass px-3 py-2 rounded-pill fw-medium">
                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> @Model.Status
            </span>
            <small class="text-muted fw-semibold">
                <i class="bi bi-building me-1"></i> @Model.ClientName
            </small>
        </div>

        <h5 class="card-title fw-bold text-dark mb-2">@Model.Title</h5>
        <p class="card-text text-muted mb-4 flex-grow-1">
            @Model.Description
        </p>

        <div class="border-top pt-3 mt-auto">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted d-block" style="font-size: 0.75rem;">ORÇAMENTO</small>
                    <span class="fw-bold text-success fs-6">
                        @Model.Budget.ToString("C", new System.Globalization.CultureInfo("pt-BR"))
                    </span>
                </div>
                <a asp-page="/Projects/Details" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm rounded-2">
                    Ver Detalhes <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
