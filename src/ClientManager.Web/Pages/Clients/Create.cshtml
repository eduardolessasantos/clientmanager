@page
@model ClientManager.Web.Pages.Clients.CreateModel
@{
    ViewData["Title"] = "Cadastro de Cliente";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Novo Cadastro de Cliente</h4>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <h5 class="text-primary mb-3"><i class="bi bi-person-badge me-2"></i>Dados Pessoais</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Input.Nome" class="form-label font-weight-bold">Nome Completo *</label>
                            <input asp-for="Input.Nome" class="form-control" placeholder="Ex: João da Silva" />
                            <span asp-validation-for="Input.Nome" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Email" class="form-label">E-mail *</label>
                            <input asp-for="Input.Email" class="form-control" type="email" placeholder="joao@empresa.com" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.CPF" class="form-label">CPF *</label>
                            <input asp-for="Input.CPF" class="form-control" placeholder="000.000.000-00" />
                            <span asp-validation-for="Input.CPF" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.RG" class="form-label">RG</label>
                            <input asp-for="Input.RG" class="form-control" placeholder="00.000.000-0" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.CNH" class="form-label">CNH</label>
                            <input asp-for="Input.CNH" class="form-control" placeholder="00000000000" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Telefone" class="form-label">Telefone / WhatsApp *</label>
                            <input asp-for="Input.Telefone" class="form-control" placeholder="(11) 99999-8888" />
                            <span asp-validation-for="Input.Telefone" class="text-danger"></span>
                        </div>
                    </div>

                    <h5 class="text-primary mb-3"><i class="bi bi-geo-alt-fill me-2"></i>Endereço</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="Input.Endereco" class="form-label">Logradouro / Endereço *</label>
                            <input asp-for="Input.Endereco" class="form-control" placeholder="Rua, Av, Travessa..." />
                            <span asp-validation-for="Input.Endereco" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Bairro" class="form-label">Bairro</label>
                            <input asp-for="Input.Bairro" class="form-control" placeholder="Bairro" />
                        </div>
                        <div class="col-md-5">
                            <label asp-for="Input.Cidade" class="form-label">Cidade</label>
                            <input asp-for="Input.Cidade" class="form-control" placeholder="São Paulo" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Input.Estado" class="form-label">UF / Estado</label>
                            <input asp-for="Input.Estado" class="form-control" placeholder="SP" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.CEP" class="form-label">CEP</label>
                            <input asp-for="Input.CEP" class="form-control" placeholder="00000-000" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-1"></i> Salvar Cliente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
